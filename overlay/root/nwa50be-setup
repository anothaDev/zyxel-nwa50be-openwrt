#!/bin/sh

set -eu

console="$(tty 2>/dev/null || true)"
case "$console" in
	/dev/console|/dev/ttyMSM*|/dev/ttyS*) ;;
	*)
		echo 'Run this helper interactively from the serial console.' >&2
		exit 1
		;;
esac

valid_ipv4_cidr() {
	value="$1"
	address=${value%/*}
	prefix=${value##*/}

	[ "$address" != "$value" ] || return 1
	case "$address" in
		''|.*|*.|*..*|*[!0-9.]*) return 1 ;;
	esac
	case "$prefix" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$prefix" -eq 32 ] 2>/dev/null || return 1

	old_ifs=$IFS
	IFS=.
	# The unquoted expansion intentionally splits a validated dotted IPv4 address.
	# shellcheck disable=SC2086
	set -- $address
	IFS=$old_ifs
	[ "$#" -eq 4 ] || return 1
	for octet in "$@"; do
		case "$octet" in
			''|*[!0-9]*) return 1 ;;
		esac
		[ "$octet" -le 255 ] 2>/dev/null || return 1
	done
}

printf 'ISO country code for this installation (example: IT): '
IFS= read -r country
country="$(printf '%s' "$country" | tr '[:lower:]' '[:upper:]')"

case "$country" in
	[A-Z][A-Z]) ;;
	*)
		echo 'Country must be exactly two ASCII letters.' >&2
		exit 1
		;;
esac

while :; do
	printf 'Wired administrator IPv4 host CIDR (must end in /32): '
	IFS= read -r management_cidr
	if valid_ipv4_cidr "$management_cidr"; then
		break
	fi
	echo 'Enter an IPv4 network in CIDR notation, for example 192.0.2.10/32.' >&2
done

echo 'Set the root password used by LuCI:'
passwd

for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	uci -q set "wireless.$radio.country=$country"
	uci -q set "wireless.$radio.disabled=1"
done
uci -q commit wireless

printf 'Enable cross-BSS client isolation after Wi-Fi is configured? [y/N]: '
IFS= read -r isolate
case "$isolate" in
	y|Y|yes|YES)
		cp /usr/share/nwa50be/99-wireless-isolation \
			/etc/hotplug.d/net/99-nwa50be-wireless-isolation
		chmod 0644 /etc/hotplug.d/net/99-nwa50be-wireless-isolation
		;;
	*)
		rm -f /etc/hotplug.d/net/99-nwa50be-wireless-isolation
		;;
esac

for section in nwa50be_management nwa50be_management_ping; do
	uci -q delete "firewall.$section"
done

uci -q set firewall.nwa50be_management='rule'
uci -q set firewall.nwa50be_management.name='Allow-trusted-management'
uci -q set firewall.nwa50be_management.src='lan'
uci -q set firewall.nwa50be_management.family='ipv4'
uci -q set firewall.nwa50be_management.proto='tcp'
uci -q add_list firewall.nwa50be_management.dest_port='22'
uci -q add_list firewall.nwa50be_management.dest_port='443'
uci -q set "firewall.nwa50be_management.src_ip=$management_cidr"
uci -q set firewall.nwa50be_management.target='ACCEPT'

uci -q set firewall.nwa50be_management_ping='rule'
uci -q set firewall.nwa50be_management_ping.name='Allow-trusted-management-ping'
uci -q set firewall.nwa50be_management_ping.src='lan'
uci -q set firewall.nwa50be_management_ping.family='ipv4'
uci -q set firewall.nwa50be_management_ping.proto='icmp'
uci -q set firewall.nwa50be_management_ping.icmp_type='echo-request'
uci -q set "firewall.nwa50be_management_ping.src_ip=$management_cidr"
uci -q set firewall.nwa50be_management_ping.target='ACCEPT'
uci -q commit firewall
/etc/init.d/firewall restart

for service in rpcd uhttpd; do
	"/etc/init.d/$service" enable
	"/etc/init.d/$service" restart
done

if [ -s /etc/dropbear/authorized_keys ]; then
	uci -q set dropbear.main.enable='1'
	uci -q commit dropbear
	/etc/init.d/dropbear enable
	/etc/init.d/dropbear restart
else
	echo 'SSH remains disabled because no authorized_keys file is installed.'
fi

umask 077
printf '%s\n' "$management_cidr" >/etc/nwa50be-management-cidr
touch /etc/nwa50be-setup-complete
chmod 0600 /etc/nwa50be-management-cidr /etc/nwa50be-setup-complete

address="$(ubus call network.interface.lan status 2>/dev/null | \
	jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null || true)"

echo
echo 'Initial setup complete. Radios remain disabled.'
if [ -n "$address" ]; then
	echo "Open LuCI at https://$address/ and configure SSIDs deliberately."
else
	echo 'Check the upstream DHCP server for the nwa50be-openwrt lease.'
fi
