destroy table bridge nwa50be_management

table bridge nwa50be_management {
	chain input {
		type filter hook input priority -200; policy accept;

		# eth0 is the sole supported wired uplink. Deny any other bridge
		# ingress, including renamed Wi-Fi and MLO interfaces.
		iifname != "eth0" drop comment "AP management requires wired ingress"
	}
}
