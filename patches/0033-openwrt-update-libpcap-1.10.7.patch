From: NWA50BE OpenWrt Project <noreply@invalid.example>
Subject: [PATCH] libpcap: update to 1.10.7
SPDX-License-Identifier: GPL-2.0-only

Take the libpcap 1.10.7 update from OpenWrt main (b36d01c696); the
openwrt-25.12 branch still ships 1.10.6. It fixes CVE-2026-0799,
CVE-2026-31911, CVE-2026-31912, CVE-2026-6244 and CVE-2026-6554 in
the BPF interpreter. The soname libpcap.so.1 is unchanged.

---
 package/libs/libpcap/Makefile                             | 6 +++---
 package/libs/libpcap/patches/100-no-openssl.patch         | 2 +-
 package/libs/libpcap/patches/102-skip-manpages.patch      | 2 +-
 .../300-Add-support-for-B.A.T.M.A.N.-Advanced.patch       | 8 ++++----
 4 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/package/libs/libpcap/Makefile b/package/libs/libpcap/Makefile
index f0ab511d4a..0209174925 100644
--- a/package/libs/libpcap/Makefile
+++ b/package/libs/libpcap/Makefile
@@ -8,12 +8,12 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=libpcap
-PKG_VERSION:=1.10.6
+PKG_VERSION:=1.10.7
 PKG_RELEASE:=1
 
-PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
+PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.xz
 PKG_SOURCE_URL:=https://www.tcpdump.org/release/
-PKG_HASH:=872dd11337fe1ab02ad9d4fee047c9da244d695c6ddf34e2ebb733efd4ed8aa9
+PKG_HASH:=68fa62cffb974f4275641ce14c2e2d75739251f30e00e6a0900903b247d76a03
 
 PKG_MAINTAINER:=Felix Fietkau <nbd@nbd.name>
 PKG_LICENSE:=BSD-3-Clause
