From: NWA50BE OpenWrt Project <noreply@invalid.example>
Subject: [PATCH] dnsmasq: update to 2.93
SPDX-License-Identifier: GPL-2.0-only

Take the dnsmasq 2.93 update from openwrt-25.12 (80d9abb3f7). It fixes
the May 2026 CERT batch (CVE-2026-2291, CVE-2026-4890..4893,
CVE-2026-5172) and the NSEC bitmap loop also filed as CVE-2026-13002
(upstream 7b151eb). Option names are unchanged from 2.91.

---
 package/network/services/dnsmasq/Makefile     |  8 ++++----
 ...00-remove-old-runtime-kernel-support.patch | 15 ++++++++------
 .../dnsmasq/patches/200-ubus_dns.patch        | 20 +++++++++----------
 3 files changed, 23 insertions(+), 20 deletions(-)

diff --git a/package/network/services/dnsmasq/Makefile b/package/network/services/dnsmasq/Makefile
index 480f1dfc2b..19ae7b7cd1 100644
--- a/package/network/services/dnsmasq/Makefile
+++ b/package/network/services/dnsmasq/Makefile
@@ -8,13 +8,13 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=dnsmasq
-PKG_UPSTREAM_VERSION:=2.91
+PKG_UPSTREAM_VERSION:=2.93
 PKG_VERSION:=$(subst test,~~test,$(subst rc,~rc,$(PKG_UPSTREAM_VERSION)))
-PKG_RELEASE:=2
+PKG_RELEASE:=1
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_UPSTREAM_VERSION).tar.xz
 PKG_SOURCE_URL:=https://thekelleys.org.uk/dnsmasq/
-PKG_HASH:=f622682848b33677adb2b6ad08264618a2ae0a01da486a93fd8cd91186b3d153
+PKG_HASH:=0c00d4e5c97c8306e5fb932b348b34269c9c29a0e7df0e8e82958b407092bc19
 
 PKG_LICENSE:=GPL-2.0
 PKG_LICENSE_FILES:=COPYING
@@ -44,7 +44,7 @@ define Package/dnsmasq/Default
   CATEGORY:=Base system
   TITLE:=DNS and DHCP server
   URL:=http://www.thekelleys.org.uk/dnsmasq/
-  DEPENDS:=+libubus
+  DEPENDS:=+libubus +@BUSYBOX_CONFIG_PIDOF
   USERID:=dnsmasq=453:dnsmasq=453
 endef
 
