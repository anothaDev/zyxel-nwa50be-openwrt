diff --git a/package/utils/busybox/patches/012-tar-protect-against-Symlink-Hardlink-attack.patch b/package/utils/busybox/patches/012-tar-protect-against-Symlink-Hardlink-attack.patch
new file mode 100644
index 0000000..7301463
--- /dev/null
+++ b/package/utils/busybox/patches/012-tar-protect-against-Symlink-Hardlink-attack.patch
@@ -0,0 +1,166 @@
+From 382008b3f07d78e3abbc50d00bb857622dbbfac6 Mon Sep 17 00:00:00 2001
+From: Denys Vlasenko <vda.linux@googlemail.com>
+Date: Fri, 9 Oct 2026 16:37:30 +0200
+Subject: [PATCH] tar: protect against Symlink+Hardlink attack
+
+function                                             old     new   delta
+create_links_from_list                                93     190     +97
+
+Signed-off-by: Denys Vlasenko <vda.linux@googlemail.com>
+[upstream commit 382008b3f, with the comment-only follow-up 32653c392
+ (libarchive: comment tweak) folded in so the code matches upstream]
+---
+ archival/libarchive/unsafe_symlink_target.c | 55 ++++++++++++++++++++++++++++++++++++++++++-------
+ testsuite/tar.tests                         | 39 +++++++++++++++++++++++++++++++----
+ 2 files changed, 82 insertions(+), 12 deletions(-)
+
+--- a/archival/libarchive/unsafe_symlink_target.c
++++ b/archival/libarchive/unsafe_symlink_target.c
+@@ -17,26 +17,65 @@ void FAST_FUNC create_or_remember_link(llist_t **link_placeholders,
+ 		return;
+ 	}
+ 	if (symlink(target, linkname) != 0) {
+-		/* shared message */
++		// shared message
+ 		bb_perror_msg_and_die("can't create %slink '%s' to '%s'",
+ 			"sym", linkname, target
+ 		);
+ 	}
+ }
+ 
++static int all_dir_components_are_dirs(char *path)
++{
++	struct stat sb;
++	char *slash;
++
++	slash = path;
++	while ((slash = strchr(slash, '/')) != NULL) {
++		int ok;
++		*slash = '\0';
++		ok = (lstat(path, &sb) == 0 && S_ISDIR(sb.st_mode));
++		*slash++ = '/';
++		if (!ok)
++			return 0;
++	}
++	return 1;
++}
++
+ void FAST_FUNC create_links_from_list(llist_t *list)
+ {
++	// This idea sounds better (fewer file ops):
++	//  Create hardlinks first, then symlinks.
++	// ^^^ but it breaks the "hardlink to symlink" case:
++	//  mkdir dir
++	//  >dir/a
++	//  ln -s ../dir/a dir/b
++	//  ln dir/b dir/c
++	//  mkdir new; tar cf - dir/a dir/b dir/c | tar -C new -xvf -
++	// On extract, 'c' will have no 'b' to be a hardlink to.
++
+ 	while (list) {
+ 		char *target;
++		char *linkname = list->data + 1;
+ 
+-		target = list->data + 1 + strlen(list->data + 1) + 1;
+-		if ((*list->data ? link : symlink) (target, list->data + 1)) {
+-			/* shared message */
+-			bb_error_msg_and_die("can't create %slink '%s' to '%s'",
+-				*list->data ? "hard" : "sym",
+-				list->data + 1, target
++		target = linkname + strlen(linkname) + 1;
++
++		// Check whether the linkname has suspicious components:
++		// SYMLINK_OUTSIDE_EXTRACT_DIR/etc/passwd sort of thing.
++		// (Our delayed creation of symlinks is not defending against it,
++		// we could create SYMLINK_OUTSIDE_EXTRACT_DIR ourself!)
++		if (!all_dir_components_are_dirs(linkname)) {
++			errno = ENOTDIR;
++			goto err;
++		}
++		if ((list->data[0] ? link : symlink) (target, linkname)) {
++			// shared message
++ err:
++			bb_perror_msg_and_die("can't create %slink '%s' to '%s'",
++				list->data[0] ? "hard" : "sym",
++				linkname, target
+ 			);
+-			/* Note: GNU tar 1.34 errors out only _after_ all links are (attempted to be) created */
++			// Note: GNU tar 1.34 errors out only _after_ all links are (attempted to be) created
++			// We bail out at once
+ 		}
+ 		list = list->link;
+ 	}
+--- a/testsuite/tar.tests
++++ b/testsuite/tar.tests
+@@ -280,7 +280,7 @@ optional UUDECODE FEATURE_TAR_AUTODETECT FEATURE_SEAMLESS_BZ2
+ testing "tar does not extract into symlinks" "\
+ >>/tmp/passwd && uudecode -o input && tar xf input 2>&1 && rm passwd; cat /tmp/passwd; echo \$?
+ " "\
+-tar: can't create symlink 'passwd' to '/tmp/passwd'
++tar: can't create symlink 'passwd' to '/tmp/passwd': File exists
+ 0
+ " \
+ "" "\
+@@ -300,7 +300,7 @@ optional UUDECODE FEATURE_TAR_AUTODETECT FEATURE_SEAMLESS_BZ2
+ testing "tar -k does not extract into symlinks" "\
+ >>/tmp/passwd && uudecode -o input && tar xf input -k 2>&1 && rm passwd; cat /tmp/passwd; echo \$?
+ " "\
+-tar: can't create symlink 'passwd' to '/tmp/passwd'
++tar: can't create symlink 'passwd' to '/tmp/passwd': File exists
+ 0
+ " \
+ "" "\
+@@ -350,7 +350,7 @@ ls symlink/bb_test_evilfile
+ anything.txt
+ symlink
+ symlink/bb_test_evilfile
+-tar: can't create symlink 'symlink' to '/tmp'
++tar: can't create symlink 'symlink' to '/tmp': File exists
+ 1
+ ls: /tmp/bb_test_evilfile: No such file or directory
+ ls: bb_test_evilfile: No such file or directory
+@@ -376,7 +376,7 @@ mkdir dir
+ ln -s ../dir/a dir/b
+ ln dir/b dir/c
+ mkdir new
+-tar cf - dir/* | tar -C new -xvf - 2>&1
++tar cf - dir/a dir/b dir/c | tar -C new -xvf - 2>&1
+ ' "\
+ dir/a
+ dir/b
+@@ -386,4 +386,35 @@ dir/c
+ SKIP=
+ cd .. || exit 1; rm -rf tar.tempdir 2>/dev/null
+ 
++mkdir tar.tempdir && cd tar.tempdir || exit 1
++testing "tar Symlink+Hardlink attack: create symlink-to-outside and then create a hardlink in it" '\
++exec 2>&1
++mkdir 2tar || exit 1
++(
++cd 2tar || exit 1
++ln -s ..    gate
++ln -s gate  alias
++ln -s alias portal
++          > seed
++ln     seed portal/ESCAPED
++#^^^ the ESCAPED file is actually in ..!
++tar cf 2tar.tar \
++        alias \
++        gate \
++        portal \
++        seed \
++        portal/ESCAPED
++rm portal/ESCAPED alias gate portal seed
++tar xf 2tar.tar
++echo $?
++)
++test -e ESCAPED && echo "ESCAPED!"
++' "\
++tar: can't create directory 'portal': No such file or directory
++tar: can't create hardlink 'portal/ESCAPED' to 'seed': Not a directory
++1
++" \
++"" ""
++cd .. || exit 1; rm -rf tar.tempdir 2>/dev/null
++
+ exit $FAILCOUNT
diff --git a/package/utils/busybox/patches/013-udhcpc-reject-ipv4-packets-shorter-than-dhcp-header.patch b/package/utils/busybox/patches/013-udhcpc-reject-ipv4-packets-shorter-than-dhcp-header.patch
new file mode 100644
index 0000000..97bb32d
--- /dev/null
+++ b/package/utils/busybox/patches/013-udhcpc-reject-ipv4-packets-shorter-than-dhcp-header.patch
@@ -0,0 +1,51 @@
+From: NWA50BE OpenWrt Project <noreply@invalid.example>
+Subject: [PATCH] udhcpc: reject IPv4 packets shorter than the DHCP header
+SPDX-License-Identifier: GPL-2.0-only
+
+LOCAL FIX, NOT AN UPSTREAM COMMIT. Remove it when busybox ships a fix
+for CVE-2026-88833.
+
+d4_recv_raw_packet() replaces the received length with the sender
+controlled ip.tot_len after its only minimum-size check. For tot_len
+below 28 (IP + UDP headers), "bytes -= sizeof(ip) + sizeof(udp)" goes
+negative and memcpy() is called with a ~2^64 length, which crashes
+udhcpc. A host on the same L2 segment can trigger it with one frame.
+The same missing check lets packet.data.cookie be read from the
+"extra garbage bytes" after tot_len.
+
+Re-check the minimum size (the expression upstream commit fd1972099
+uses for the received length) after bytes = ntohs(ip.tot_len).
+
+Upstream status checked 2026-10-31: master 5eee8017a (2026-10-22) has
+no fix; fd1972099 only checks the received length. The patch posted on
+the list on 2026-09-19 ("reject udp.len < sizeof(udp)") is not merged
+and does not cover tot_len < 20 (udp.len wraps to 0xffec..0xffff).
+---
+ networking/udhcp/dhcpc.c | 16 ++++++++++++++++
+ 1 file changed, 16 insertions(+)
+
+--- a/networking/udhcp/dhcpc.c
++++ b/networking/udhcp/dhcpc.c
+@@ -914,6 +914,22 @@ static NOINLINE int d4_recv_raw_packet(struct dhcp_packet *dhcp_pkt, int fd)
+ 	/* ignore any extra garbage bytes */
+ 	bytes = ntohs(packet.ip.tot_len);
+ 
++	/* tot_len is controlled by the sender and may be much smaller
++	 * than what recvmsg() returned. We now use it as the packet size,
++	 * so re-do the minimum size check: otherwise "bytes -= headers" below
++	 * underflows, memcpy() gets a ~2^64 length and we crash; also
++	 * packet.data.cookie must lie within the packet, not in "garbage bytes"
++	 */
++	if (bytes < (int) (
++			sizeof(packet.ip) + sizeof(packet.udp)
++			+ offsetof(struct dhcp_packet, options)
++			/* DHCP requires option 255 is always present, IOW: at least one byte in options[]: */
++			+ 1
++	)) {
++		log1s("packet is too short, ignoring");
++		return -2;
++	}
++
+ 	/* make sure its the right packet for us, and that it passes sanity checks */
+ 	if (packet.ip.protocol != IPPROTO_UDP
+ 	 || packet.ip.version != IPVERSION
