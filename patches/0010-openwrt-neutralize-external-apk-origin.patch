From: NWA50BE OpenWrt Project <noreply@invalid.example>
Subject: [PATCH] apk: neutralize absolute external-feed origins

src-link feeds outside TOPDIR produce absolute package SOURCE paths. Preserve
SOURCE for package build logic, but store a stable external/<package> value in
APK metadata instead of leaking the build host path into the firmware.

--- a/include/package-pack.mk
+++ b/include/package-pack.mk
@@ -597,7 +597,7 @@ endif
 	  --info "description:$$(call description_escape,$$(strip $$(Package/$(1)/description)))" \
 	  $(if $(findstring all,$(PKGARCH)),--info "arch:noarch",--info "arch:$(PKGARCH)") \
 	  --info "license:$(LICENSE)" \
-	  --info "origin:$(SOURCE)" \
+	  --info "origin:$(if $(filter /%,$(SOURCE)),external/$(notdir $(SOURCE)),$(SOURCE))" \
 	  --info "url:$(URL)" \
 	  --info "maintainer:$(MAINTAINER)" \
 	  $$(if $$(Package/$(1)/PROVIDES),--info "provides:$$(Package/$(1)/PROVIDES)") \
