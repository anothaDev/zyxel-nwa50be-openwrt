From: NWA50BE recovery-kit build guard
Subject: [PATCH] kernel: invalidate stale embedded initramfs payload
SPDX-License-Identifier: GPL-2.0-only

The vendor-patched tree can retain usr/initramfs_inc_data from the normal
kernel build when it switches CONFIG_INITRAMFS_SOURCE for the initramfs
kernel.  Removing only initramfs_data.cpio is insufficient in this tree:
Kbuild then reuses the old 512-byte payload and emits an initramfs image that
is byte-identical to the normal kernel.

Remove the generated compressed payload and its two containing objects as
well.  This forces regeneration and relinking without changing runtime code.

--- a/include/kernel-defaults.mk
+++ b/include/kernel-defaults.mk
@@ -188,7 +188,10 @@ define Kernel/CompileImage/Initramfs
 		$(call Kernel/Configure/Initramfs,$(if $(1),$(1),$(TARGET_DIR)),$(LINUX_DIR)$(2)); \
 		$(CP) $(GENERIC_OTHER_FILES_DIR)/init $(if $(1),$(1),$(TARGET_DIR))/init; \
 		$(if $(SOURCE_DATE_EPOCH),touch -hcd "@$(SOURCE_DATE_EPOCH)" $(if $(1),$(1),$(TARGET_DIR)) $(if $(1),$(1),$(TARGET_DIR))/init;) \
-		rm -rf $(LINUX_DIR)$(2)/usr/initramfs_data.cpio*; \
+		rm -rf $(LINUX_DIR)$(2)/usr/initramfs_data.cpio* \
+			$(LINUX_DIR)$(2)/usr/initramfs_inc_data \
+			$(LINUX_DIR)$(2)/usr/initramfs_data.o \
+			$(LINUX_DIR)$(2)/usr/built-in.a; \
 		$(if $(CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE), \
 			$(call locked,{ \
 				$(if $(call qstrip,$(CONFIG_EXTERNAL_CPIO)), \
