diff --git a/feeds/qca-wifi-7/ipq53xx/patches-6.6/903-tcp-exclude-old-acks-from-tcp-fast-path.patch b/feeds/qca-wifi-7/ipq53xx/patches-6.6/903-tcp-exclude-old-acks-from-tcp-fast-path.patch
