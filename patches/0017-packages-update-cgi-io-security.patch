From: NWA50BE OpenWrt Project <noreply@invalid.example>
Subject: [PATCH] cgi-io: update past CVE-2026-62947
SPDX-License-Identifier: GPL-2.0-only

Update cgi-io to the revision selected by the current OpenWrt 25.12
packages feed. This includes the cgi-download path validation fix for
CVE-2026-62947.

---
 net/cgi-io/Makefile | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/net/cgi-io/Makefile b/net/cgi-io/Makefile
--- a/net/cgi-io/Makefile
+++ b/net/cgi-io/Makefile
@@ -10,9 +10,9 @@ PKG_NAME:=cgi-io
 PKG_RELEASE:=1
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL=$(PROJECT_GIT)/project/cgi-io.git
-PKG_SOURCE_DATE:=2025-12-11
-PKG_SOURCE_VERSION:=658b14bda2a0fb617fa456401daee61aae42c805
-PKG_MIRROR_HASH:=1fafd6edd7a731427ea8ad1a3b02ebd59a46389e1c7afc8e16d4fd1f79af4659
+PKG_SOURCE_DATE:=2026-07-21
+PKG_SOURCE_VERSION:=31cb3c89f02d918d7f17bf62a80c852fc38a1ca1
+PKG_MIRROR_HASH:=ecb2ce93b5f62d9fa35ca2b514faa5ef14e462d782bc1dd0de0e4b2ecabcec71
 CMAKE_INSTALL:=1
 
 PKG_LICENSE:=GPL-2.0-or-later
