 /*
- * RAM-test image safety interlock. The kernel and rootfs are loaded into RAM;
- * stock SPI NOR and NAND must not be exposed to Linux at all.
+ * Keep bootloader, environment, and ART inaccessible from Linux. Persistent
+ * OpenWrt is installed only into the NAND rootfs UBI partition.
  */
 &blsp1_spi0 {
 	status = "disabled";
 };
 
 &qpic_bam {
-	status = "disabled";
+	status = "okay";
 };
 
 &qpic_nand {
-	status = "disabled";
+	status = "okay";
 };
