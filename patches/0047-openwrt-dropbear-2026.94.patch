diff --git a/package/network/services/dropbear/patches/003-scp-keep-the-error-marker-in-run_err.patch b/package/network/services/dropbear/patches/003-scp-keep-the-error-marker-in-run_err.patch
new file mode 100644
index 0000000000000000000000000000000000000000..bd369c167b212a777d88a5f9559e8558f9786afe
--- /dev/null
+++ b/package/network/services/dropbear/patches/003-scp-keep-the-error-marker-in-run_err.patch
@@ -0,0 +1,33 @@
+From 3cae588407ea43e8a9062a0b84fc9ecaf0717f8c Mon Sep 17 00:00:00 2001
+From: NWA50BE OpenWrt Project <noreply@invalid.example>
+Date: Sat, 31 Oct 2026 20:21:59 +0100
+Subject: [PATCH] scp: keep the error marker in run_err()
+
+Upstream 17549ea6 ("Fix terminal escaping in scp") builds the remote
+error message as "\001scp: ..." and then passes the whole buffer to
+cleantext(), which drops the 0x01 byte as a control character. The peer
+then sees an unmarked protocol line, so one missing or unreadable file
+aborts a batch transfer instead of being reported and skipped. Clean
+only the text after the marker, and without whitespace, so a newline in
+a remote filename cannot split the protocol line either.
+
+Local fix for the NWA50BE fork; not an upstream commit yet.
+---
+ src/scp.c | 4 +++-
+ 1 file changed, 3 insertions(+), 1 deletion(-)
+
+diff --git a/src/scp.c b/src/scp.c
+index 67f524bb..257c16b7 100644
+--- a/src/scp.c
++++ b/src/scp.c
+@@ -1477,7 +1477,9 @@ run_err(const char *fmt,...)
+ 	va_start(ap, fmt);
+ 	pos += vsnprintf(&buf[pos], sizeof(buf)-pos, fmt, ap);
+ 	va_end(ap);
+-	cleantext(buf, 1);
++	/* Keep the leading 0x01 (recoverable error) marker, and keep the
++	 * message on one protocol line: no newlines or tabs from filenames. */
++	cleantext(&buf[1], 0);
+ 	fprintf(fp, "%s\n", buf);
+ 	(void) fflush(fp);
+ 
