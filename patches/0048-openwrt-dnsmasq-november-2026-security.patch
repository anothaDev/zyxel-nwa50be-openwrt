++	    }
++	  
++	  /* unblock parent now we're not holding sockets we shouldn't. */
+ 	  read_write(pipefd[1], &a, 1, RW_WRITE);
+-#endif		  
++	
+ 	  alarm(CHILD_LIFETIME);
