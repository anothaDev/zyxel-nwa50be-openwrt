diff --git a/package/network/services/dnsmasq/patches/022-Close-listening-socket-on-fatal-accept-errors-to-pre.patch b/package/network/services/dnsmasq/patches/022-Close-listening-socket-on-fatal-accept-errors-to-pre.patch
new file mode 100644
index 0000000..c29422a
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/022-Close-listening-socket-on-fatal-accept-errors-to-pre.patch
@@ -0,0 +1,56 @@
+From a9880c595f052d63859d6ed8aa86a3a6b007bf20 Mon Sep 17 00:00:00 2001
+From: Yuefu Zhou <yuefu16.zhou@gmail.com>
+Date: Thu, 20 Aug 2026 14:39:41 +0800
+Subject: [PATCH] Close listening socket on fatal accept() errors to prevent
+ busy loop
+
+If a TCP listening socket is externally destroyed (e.g., via ss -K,
+or a process using NETLINK_SOCK_DIAG/SOCK_DESTROY), accept()
+permanently returns -1 with errno == EINVAL because the socket is
+no longer in TCP_LISTEN state.  Since poll() keeps reporting the
+stale fd as readable, the main loop spins calling
+do_tcp_connection() -> accept() indefinitely, consuming 100% CPU.
+
+Distinguish transient errors (EAGAIN, ECONNABORTED, EMFILE, ENFILE,
+ENOMEM, ENOBUFS) from fatal ones.  On transient errors just return
+and retry on the next poll cycle.  On fatal errors close the tcpfd
+and mark it -1 so poll() no longer selects it.
+
+In --bind-dynamic mode the listener will be automatically rebuilt
+on the next address change event via newaddress().
+
+Signed-off-by: Yuefu Zhou <yuefu16.zhou@gmail.com>
+(cherry picked from commit a9880c595f052d63859d6ed8aa86a3a6b007bf20)
+---
+ src/dnsmasq.c | 15 ++++++++++++++-
+ 1 file changed, 14 insertions(+), 1 deletion(-)
+
+diff --git a/src/dnsmasq.c b/src/dnsmasq.c
+index 1a62628..4d6f4d0 100644
+--- a/src/dnsmasq.c
++++ b/src/dnsmasq.c
+@@ -2039,7 +2039,20 @@ static void do_tcp_connection(struct listener *listener, time_t now, int slot)
+   while ((confd = accept(listener->tcpfd, NULL, NULL)) == -1 && errno == EINTR);
+   
+   if (confd == -1)
+-    return;
++    {
++      /* Transient errors: just return and retry on next poll cycle. */
++      if (errno == EAGAIN || errno == ECONNABORTED ||
++          errno == EMFILE || errno == ENFILE ||
++          errno == ENOMEM || errno == ENOBUFS)
++        return;
++
++      /* Fatal error (EINVAL, EBADF, etc): socket is permanently broken.
++         Close it so poll() no longer selects it.  In --bind-dynamic mode
++         the listener will be rebuilt on the next address change event. */
++      close(listener->tcpfd);
++      listener->tcpfd = -1;
++      return;
++    }
+   
+   if (getsockname(confd, (struct sockaddr *)&tcp_addr, &tcp_len) == -1)
+     {
+-- 
+2.56.0
+
diff --git a/package/network/services/dnsmasq/patches/023-Don-t-bump-arrsize-in-poll_listen-until-the-realloc-.patch b/package/network/services/dnsmasq/patches/023-Don-t-bump-arrsize-in-poll_listen-until-the-realloc-.patch
new file mode 100644
index 0000000..2974d91
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/023-Don-t-bump-arrsize-in-poll_listen-until-the-realloc-.patch
@@ -0,0 +1,43 @@
+From baeb7430e26f9e1c0f08b763809305f1c54763f6 Mon Sep 17 00:00:00 2001
+From: Martin Vlach <userhuge@gmail.com>
+Date: Thu, 1 Oct 2026 01:00:05 +0200
+Subject: [PATCH] Don't bump arrsize in poll_listen() until the realloc has
+ succeeded.
+
+If whine_realloc() fails in poll_listen(), arrsize has already been
+doubled while pollfds keeps its old size. The next call then sees
+arrsize != nfds, skips the extension and writes past the end of the
+array (or through NULL if the very first allocation failed).
+poll_reset() only clears nfds, so this sticks around until restart.
+
+Only update arrsize once the reallocation has succeeded.
+
+(cherry picked from commit baeb7430e26f9e1c0f08b763809305f1c54763f6)
+---
+ src/poll.c | 6 +++---
+ 1 file changed, 3 insertions(+), 3 deletions(-)
+
+diff --git a/src/poll.c b/src/poll.c
+index d2d1fb9..5f0bf5a 100644
+--- a/src/poll.c
++++ b/src/poll.c
+@@ -100,13 +100,13 @@ void poll_listen(int fd, short event)
+ 	 {
+ 	   /* Array too small. Extend. */
+ 	   struct pollfd *new;
++	   nfds_t newsize = (arrsize == 0) ? 64 : arrsize * 2;
+ 
+-	   arrsize = (arrsize == 0) ? 64 : arrsize * 2;
+-
+-	   if (!(new = whine_realloc(pollfds, arrsize * sizeof(struct pollfd))))
++	   if (!(new = whine_realloc(pollfds, newsize * sizeof(struct pollfd))))
+ 	     return;
+ 
+ 	   pollfds = new;
++	   arrsize = newsize;
+ 	 }
+ 
+        memmove(&pollfds[i+1], &pollfds[i], (nfds - i) * sizeof(struct pollfd));
+-- 
+2.56.0
+
diff --git a/package/network/services/dnsmasq/patches/024-Answer-queued-TCP-queries-after-a-stale-answer.patch b/package/network/services/dnsmasq/patches/024-Answer-queued-TCP-queries-after-a-stale-answer.patch
new file mode 100644
index 0000000..a71384a
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/024-Answer-queued-TCP-queries-after-a-stale-answer.patch
@@ -0,0 +1,93 @@
+From bc80b93cd10a3e4f6a846dd3db0cf73af79b1a1f Mon Sep 17 00:00:00 2001
+From: DL6ER <dl6er@dl6er.de>
+Date: Tue, 13 Oct 2026 17:00:26 +0200
+Subject: [PATCH] Answer queued TCP queries after a stale answer
+
+When `tcp_request()` answers from stale cache data, it closes the
+connection right away, so that the child process can refresh the name
+and exit. A query the client has already sent on that connection is
+never read, and its answer is lost.
+
+glibc runs into this: after a truncated UDP reply, it sends the A and
+AAAA queries together on one TCP connection, gets EOF after the first
+answer and fails the lookup without retrying the second query. In a
+test with both answers expired, 7 of 20 such lookups lost the second
+answer.
+
+Close the connection only if the client has not sent anything else
+yet. Otherwise, refresh the name and go on answering the queries on the
+connection, as for any other forwarded query.
+
+Signed-off-by: DL6ER <dl6er@dl6er.de>
+(cherry picked from commit bc80b93cd10a3e4f6a846dd3db0cf73af79b1a1f)
+---
+ src/forward.c | 30 +++++++++++++++++++++++-------
+ 1 file changed, 23 insertions(+), 7 deletions(-)
+
+diff --git a/src/forward.c b/src/forward.c
+index acaaafc..1024e08 100644
+--- a/src/forward.c
++++ b/src/forward.c
+@@ -2406,7 +2406,7 @@ void tcp_request(int confd, time_t now, struct iovec *bigbuff,
+   unsigned char *pheader;
+   unsigned int mark = 0;
+   int have_mark = 0;
+-  int first, last, filtered, do_stale = 0;
++  int first, last, filtered, do_stale = 0, closed = 0;
+   struct iovec out_iov[2];
+   
+   bigbuff->iov_base = NULL;
+@@ -2742,8 +2742,16 @@ void tcp_request(int confd, time_t now, struct iovec *bigbuff,
+ 	    }
+ 	}
+ 
++      /* Fresh data is in the cache now. Go on with the queries the client
++	 had already sent, if the connection is still open. */
+       if (do_stale)
+-	break;
++	{
++	  if (closed)
++	    break;
++	  do_stale = 0;
++	  daemon->log_source_addr = &peer_addr;
++	  continue;
++	}
+       
+       /* In case of local answer or no connections made. */
+       if (m == 0)
+@@ -2792,19 +2800,27 @@ void tcp_request(int confd, time_t now, struct iovec *bigbuff,
+       /* If we answered with stale data, this process will now try and get fresh data into
+ 	 the cache and cannot therefore accept new queries. Close the incoming
+ 	 connection to signal that to the client. Then set do_stale and loop round
+-	 once more to try and get fresh data, after which we exit. */
++	 once more to try and get fresh data, after which we exit. A client which
++	 has already sent its next query is waiting for the answer and would lose
++	 it, so keep the connection open then and answer it after the refresh. */
+       if (stale)
+ 	{
+-	  shutdown(confd, SHUT_RDWR);
+-	  close(confd);
++	  char c;
++	  
++	  if (recv(confd, &c, 1, MSG_PEEK | MSG_DONTWAIT) != 1)
++	    {
++	      shutdown(confd, SHUT_RDWR);
++	      close(confd);
++	      closed = 1;
++	    }
+ 	  do_stale = 1;
+ 	  /* Don't mark the query with the source when refreshing stale data. */
+ 	  daemon->log_source_addr = NULL;
+ 	}
+     }
+   
+-/* If we ran once to get fresh data, confd is already closed. */
+-  if (!do_stale)
++/* If we ran once to get fresh data, confd may be closed already. */
++  if (!closed)
+     {
+       shutdown(confd, SHUT_RDWR);
+       close(confd);
+-- 
+2.56.0
+
diff --git a/package/network/services/dnsmasq/patches/025-Fix-the-NSEC3-closest-encloser-check-for-deeper-wild.patch b/package/network/services/dnsmasq/patches/025-Fix-the-NSEC3-closest-encloser-check-for-deeper-wild.patch
new file mode 100644
index 0000000..441b1da
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/025-Fix-the-NSEC3-closest-encloser-check-for-deeper-wild.patch
@@ -0,0 +1,45 @@
+From 3a3e7a049f2ffd00e4e9db87e081ce24d458b5fc Mon Sep 17 00:00:00 2001
+From: DL6ER <dl6er@dl6er.de>
+Date: Tue, 13 Oct 2026 17:00:24 +0200
+Subject: [PATCH] Fix the NSEC3 closest encloser check for deeper wildcard
+ answers
+
+`validate_rrset()` returns the start of the closest encloser as an offset
+into the owner name, and `prove_non_existence_nsec3()` is meant to stop
+its search there. It compares `name - closest_encloser` with that offset,
+but `closest_encloser` only moves forward from `name`, so the difference
+is never positive and the search never stops at the encloser the RRSIG
+labels field gives.
+
+A wildcard answer one label below the closest encloser is not affected,
+as the NSEC3 covering the next closer name covers the query name itself.
+Two or more labels below, dnsmasq looks for an NSEC3 matching the closest
+encloser, which RFC 5155 section 7.2.6 does not require the zone to send,
+and returns SERVFAIL with EDE 12 (NSEC Missing). An example is
+foo.login.us2.yubico.com, answered from *.us2.yubico.com.
+
+The comparison came with f603a4f ("Fix a corner-case in DNSSEC validation
+with wildcards."), which replaced the name compare. Swap the operands.
+
+Signed-off-by: DL6ER <dl6er@dl6er.de>
+(cherry picked from commit 3a3e7a049f2ffd00e4e9db87e081ce24d458b5fc)
+---
+ src/dnssec.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/src/dnssec.c b/src/dnssec.c
+index 5a11f68..8b70aa4 100644
+--- a/src/dnssec.c
++++ b/src/dnssec.c
+@@ -1644,7 +1644,7 @@ static int prove_non_existence_nsec3(struct dns_header *header, size_t plen, uns
+       if (*closest_encloser == '.')
+ 	closest_encloser++;
+ 
+-      if (wild_offset != 0 && name - closest_encloser == wild_offset)
++      if (wild_offset != 0 && closest_encloser - name == wild_offset)
+ 	break;
+       
+       if (dec_counter(validate_counter, NULL))
+-- 
+2.56.0
+
diff --git a/package/network/services/dnsmasq/patches/026-Ignore-DHCP-leasequery-when-no-permitted-source-is-c.patch b/package/network/services/dnsmasq/patches/026-Ignore-DHCP-leasequery-when-no-permitted-source-is-c.patch
new file mode 100644
index 0000000..310c97d
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/026-Ignore-DHCP-leasequery-when-no-permitted-source-is-c.patch
@@ -0,0 +1,70 @@
+From 4bd9d48473889ede6b8597ddd6e70a92eebbcbd0 Mon Sep 17 00:00:00 2001
+From: NWA50BE OpenWrt Project <noreply@invalid.example>
+Date: Sat, 31 Oct 2026 20:11:09 +0100
+Subject: [PATCH] Ignore DHCP leasequery when no permitted source is configured
+
+With --leasequery given without an address, the DHCPv4 server answered
+LEASEQUERY messages from any source, so any host on the local network
+could read lease records: assigned addresses, MAC addresses, hostnames
+and other lease metadata.
+
+Fail closed instead: when no permitted source address or subnet is
+configured, ignore LEASEQUERY messages and log a warning only once, so
+the log can't be flooded. With one or more sources configured the
+behaviour is unchanged. dnsmasq 2.93 has no DHCPv6 leasequery, so only
+the DHCPv4 path is changed.
+
+This is a local fix for CVE-2026-93010; there is no upstream commit yet.
+---
+ man/dnsmasq.8 |  6 ++++--
+ src/rfc2131.c | 17 +++++++++++++++++
+ 2 files changed, 21 insertions(+), 2 deletions(-)
+
+diff --git a/man/dnsmasq.8 b/man/dnsmasq.8
+index 5b01e63..0f5a64f 100644
+--- a/man/dnsmasq.8
++++ b/man/dnsmasq.8
+@@ -1445,8 +1445,10 @@ forces "simple and safe" behaviour to avoid problems in such a case.
+ .TP
+ .B --leasequery[=<addr>[/<prefix>]]
+ Enable RFC 4388 leasequery. The dnsmasq DHCP server will answer LEASEQUERY messages from DHCP relays
+-when this option is given. If an address or subnet is given, only queries from a relay at that source are allowed. Repeat
+-the --leasequery option to specify multiple allowed sources.
++at the addresses or subnets given; queries from any other source are not answered. Repeat
++the --leasequery option to specify multiple allowed sources. At least one source must be given:
++if the option is used without an address, the extra lease data below is still stored but all
++LEASEQUERY messages are ignored, and a warning is logged the first time one arrives.
+ To correctly answer lease queries it is necessary to store extra data in
+ the lease database, and this is also enabled by the \fB--leasequery\fP option. The extra fields
+ (agent-info and vendorclass) are stored in the leases file in a somewhat backwards compatible manner.
+diff --git a/src/rfc2131.c b/src/rfc2131.c
+index ec0194b..ba33247 100644
+--- a/src/rfc2131.c
++++ b/src/rfc2131.c
+@@ -1075,6 +1075,23 @@ size_t dhcp_reply(struct dhcp_context *context, char *iface_name, int int_index,
+ 
+       inet_ntop(AF_INET, &leasequery_source, daemon->workspacename, ADDRSTRLEN);
+ 
++      /* Without a list of permitted sources, any host could read the
++	 lease database. Fail closed, and log only once so that this
++	 can't be used to flood the log. */
++      if (!daemon->leasequery_addr)
++	{
++	  static int warned = 0;
++
++	  if (!warned)
++	    {
++	      my_syslog(MS_DHCP | LOG_WARNING,
++			_("leasequery from %s ignored: no permitted source given to --leasequery (logged only once)"),
++			daemon->workspacename);
++	      warned = 1;
++	    }
++	  return 0;
++	}
++
+       if (daemon->leasequery_addr)
+ 	{
+ 	  struct bogus_addr *baddrp;
+-- 
+2.56.0
+
